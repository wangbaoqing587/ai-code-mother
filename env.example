# 复制为 .env 填写密码，并在 IDE 运行配置或 shell 中加载环境变量：
# 只加载环境变量、不启动：set -a && source .env && set +a
# 加载环境变量并启动：set -a && source .env && set +a && ./mvnw spring-boot:run

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# 服务
SERVER_PORT=8123

# 代码生成/部署/静态预览（tmp 目录绝对路径）
AI_CODE_TMP_ROOT=

# LLM（OpenAI 兼容）
LLM_BASE_URL=
LLM_API_KEY=
LLM_CHAT_MODEL_NAME=
LLM_STREAMING_MODEL_NAME=
LLM_REASONING_MODEL_NAME=
LLM_ROUTING_MODEL_NAME=

# 腾讯云 COS
COS_HOST=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_BUCKET=

# 第三方 API
PEXELS_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_IMAGE_MODEL=
